{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/golden-age-society run build",
  "outputDirectory": "artifacts/golden-age-society/dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "attached_assets/gas-logo.png"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
